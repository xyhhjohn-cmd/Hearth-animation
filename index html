<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Blue Energy Animation</title>

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #000;
    }

    canvas {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
</head>

<body>

<canvas id="canvas"></canvas>

<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}

resize();

window.addEventListener("resize", resize);


// PARTICLES
const particles = [];

const PARTICLE_COUNT = 350;

class Particle {

    constructor() {
        this.reset();
    }

    reset() {

        this.x = canvas.width / 2;
        this.y = canvas.height / 2;

        const angle = Math.random() * Math.PI * 2;

        const speed = Math.random() * 7 + 1;

        this.vx = Math.cos(angle) * speed;
        this.vy = Math.sin(angle) * speed;

        this.size = Math.random() * 2.5 + 0.5;

        this.life = 1;

        this.decay = Math.random() * 0.015 + 0.005;
    }

    update() {

        this.x += this.vx;
        this.y += this.vy;

        this.vx *= 0.985;
        this.vy *= 0.985;

        this.life -= this.decay;

        if (this.life <= 0) {
            this.reset();
        }
    }

    draw() {

        ctx.beginPath();

        ctx.arc(
            this.x,
            this.y,
            this.size,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            `rgba(40, 150, 255, ${this.life})`;

        ctx.shadowBlur = 15;

        ctx.shadowColor = "#008cff";

        ctx.fill();
    }
}


// CREATE PARTICLES

for (let i = 0; i < PARTICLE_COUNT; i++) {

    particles.push(
        new Particle()
    );

}


// ANIMATION

function animate() {

    requestAnimationFrame(animate);

    ctx.fillStyle = "rgba(0,0,0,0.18)";

    ctx.fillRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    for (const particle of particles) {

        particle.update();

        particle.draw();

    }
}

animate();

</script>

</body>
</html>
